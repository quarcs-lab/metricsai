# Quarto
book/.quarto/
notebooks_colab/*_files/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

/.quarto/
**/*.quarto_ipynb

# Generated notebook outputs (HTML/PDF)
notebooks_colab/*.html
notebooks_colab/*.pdf

# Quarto build artifacts
notebooks_quarto/*.html
notebooks_quarto/*_files/

# Slide decks (write-slides skill): commit the rendered deck (index.html + slides_files/
# + figures/) but ignore the figure-export staging cache and Quarto's local cache.
slides/*/_figcache/
slides/*/.quarto/

# Chapter quizzes (write-quiz skill): commit banks, built pages, and fact-checks;
# ignore local browser-test output (screenshots/PDFs) when no session scratchpad is used.
quizzes/.tests/
